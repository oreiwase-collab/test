    {
      "start": 0.0,
      "end": 2.9333,
      "text": "たくさんの人が行き交う\n駅のど真ん中で"
    },
    {
      "start": 2.9333,
      "end": 6.1,
      "text": "服を脱ぐなんて絶対に\nあり得ないと思いますよね"
    },
    {
      "start": 6.1,
      "end": 10.4333,
      "text": "でもたった畳1枚分の\n小さな箱に入るだけで"
    },
    {
      "start": 10.4333,
      "end": 13.8333,
      "text": "人間の脳は信じられない\n勘違いを起こしてしまいます"
    },
    {
      "start": 13.8333,
      "end": 17.9333,
      "text": "2026年9月\n都内の大きな駅に置かれた"
    },
    {
      "start": 17.9333,
      "end": 21.3333,
      "text": "テレワーク用の防音個室\n「ステーションポッド」の中で"
    },
    {
      "start": 21.3333,
      "end": 25.0,
      "text": "服を脱いで外に見せびらかすような\n動画がネットに広まり"
    },
    {
      "start": 25.0,
      "end": 28.2667,
      "text": "警察が動く\n大きな騒ぎになりました"
    }
