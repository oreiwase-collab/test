{
  "name": "narrated-illustrated-video",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "studio": "remotion studio src/index.ts",
    "typecheck": "tsc --noEmit",
    "still": "remotion still src/index.ts NarratedIllustratedVideo out/preview.png --frame=90",
    "render:preview": "remotion render src/index.ts NarratedIllustratedVideo out/preview.mp4 --codec=h264 --crf=24 --audio-codec=aac --scale=0.5",
    "render": "remotion render src/index.ts NarratedIllustratedVideo out/final.mp4 --codec=h264 --crf=18 --audio-codec=aac"
  },
  "dependencies": {
    "@fontsource/noto-sans-jp": "^5.3.0",
    "@remotion/cli": "4.0.502",
    "@remotion/media": "4.0.502",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "remotion": "4.0.502"
  },
  "devDependencies": {
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "typescript": "5.9.3"
  }
}
