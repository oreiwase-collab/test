00001, 50.50000000000001, 51.50000000000001, 52.50000000000001, 52.50000000000001]}, {"text": "都市について研究していたエドワードソジャという学者が、1996年にロサンゼルスの街で調査を行いました。", "row": 17, "start": 137.35666666666668, "end": 145.42666666666668, "knots": [[0, 137.35666666666668], [26, 140.68666666666667], [27, 141.05666666666667], [51, 145.42666666666668]], "cum": [0, 1.7, 3.4, 4.4, 5.4, 6.4, 7.4, 9.1, 10.799999999999999, 11.799999999999999, 12.799999999999999, 13.799999999999999, 14.799999999999999, 15.799999999999999, 16.799999999999997, 17.799999999999997, 18.799999999999997, 19.799999999999997, 20.799999999999997, 21.799999999999997, 22.799999999999997, 23.799999999999997, 24.799999999999997, 25.799999999999997, 27.499999999999996, 29.199999999999996, 30.199999999999996, 30.199999999999996, 32.699999999999996, 35.199999999999996, 37.699999999999996, 40.199999999999996, 41.9, 42.9, 43.9, 44.9, 45.9, 46.9, 47.9, 48.9, 49.9, 51.6, 52.6, 54.300000000000004, 56.00000000000001, 57.00000000000001, 58.70000000000001, 59.70000000000001, 60.70000000000001, 61.70000000000001, 62.70000000000001, 62.70000000000001]}, {"text": "誰もが自由に使えた広場をフェンスで囲み、お金を払った人だけが入れる小さなブースに区切った場所で、半年間にわたって人々の様子を観察したのです。", "row": 18, "start": 146.2566666666667, "end": 156.60666666666668, "knots": [[0, 146.2566666666667], [19, 148.96666666666667], [20, 149.4766666666667], [47, 153.11166666666668], [48, 153.62166666666667], [70, 156.60666666666668]], "cum": [0, 1.7, 2.7, 3.7, 5.4, 7.1000000000000005, 8.100000000000001, 9.8, 10.8, 11.8, 13.5, 15.2, 16.2, 17.2, 18.2, 19.2, 20.2, 21.2, 22.9, 23.9, 23.9, 24.9, 26.599999999999998, 27.599999999999998, 29.299999999999997, 30.299999999999997, 31.299999999999997, 33.0, 34.0, 35.0, 36.0, 37.7, 38.7, 39.7, 41.400000000000006, 42.400000000000006, 43.400000000000006, 44.400000000000006, 45.400000000000006, 46.400000000000006, 47.400000000000006, 49.10000000000001, 50.80000000000001, 51.80000000000001, 52.80000000000001, 54.500000000000014, 56.20000000000002, 57.20000000000002, 57.20000000000002, 58.90000000000002, 60.60000000000002, 62.300000000000026, 63.300000000000026, 64.30000000000003, 65.30000000000003, 66.30000000000003, 67.30000000000003, 69.00000000000003, 70.00000000000003, 71.00000000000003, 72.70000000000003, 74.40000000000003, 75.40000000000003, 77.10000000000004, 78.80000000000004, 79.80000000000004, 80.80000000000004, 81.80000000000004, 82.80000000000004, 83.80000000000004, 83.80000000000004]}, {"text": "防犯カメラをたくさん増やしたにもかかわらず、ブースの中でルールを破るいたずらや迷惑行為は、もとの広場の約3倍に増えてしまいました。", "row": 19, "start": 157.57666666666668, "end": 166.43666666666667, "knots": [[0, 157.57666666666668], [21, 159.93666666666667], [22, 160.4416666666667], [44, 163.5916666666667], [45, 163.95166666666668], [65, 166.43666666666667]], "cum": [0, 1.7, 3.4, 4.4, 5.4, 6.4, 7.4, 8.4, 9.4, 10.4, 11.4, 13.1, 14.1, 15.1, 16.1, 17.1, 18.1, 19.1, 20.1, 21.1, 22.1, 23.1, 23.1, 24.1, 25.1, 26.1, 27.1, 28.8, 29.8, 30.8, 31.8, 32.8, 33.8, 35.5, 36.5, 37.5, 38.5, 39.5, 40.5, 41.5, 43.2, 44.900000000000006, 46.60000000000001, 48.30000000000001, 49.30000000000001, 49.30000000000001, 50.30000000000001, 51.30000000000001, 52.30000000000001, 54.000000000000014, 55.70000000000002, 56.70000000000002, 58.40000000000002, 60.90000000000002, 62.60000000000002, 63.60000000000002, 65.30000000000003, 66.30000000000003, 67.30000000000003, 68.30000000000003, 69.30000000000003, 70.30000000000003, 71.30000000000003, 72.30000000000003, 73.30000000000003, 73.30000000000003]}, {"text": "広場を細かく区切って個室にしてしまうと、お互いに見守り合う自然なブレーキが壊れてしまうのです。", "row": 20, "start": 167.31666666666666, "end": 173.56666666666666, "knots": [[0, 167.31666666666666], [19, 169.8216666666667], [20, 170.2566666666667], [47, 173.56666666666666]], "cum": [0, 1.7, 3.4, 4.4, 6.1000000000000005, 7.1000000000000005, 8.100000000000001, 9.8, 11.5, 12.5, 13.5, 15.2, 16.9, 17.9, 18.9, 19.9, 20.9, 21.9, 22.9, 23.9, 23.9, 24.9, 26.599999999999998, 27.599999999999998, 28.599999999999998, 30.299999999999997, 31.999999999999996, 33.0, 34.7, 35.7, 37.4000000000